# Copy this file to .env.local (gitignored) and fill in your device's LAN IP.
# Only needed for testing on a PHYSICAL device — the iOS simulator and Android
# emulator already work via their own localhost/10.0.2.2 defaults with no env
# vars set at all. Both servers must be started with the device's Wi-Fi network
# reachable (see AGENTS.md), and Metro must be restarted with --clear after any
# change here — these are inlined into the JS bundle at bundle time, not read
# live.

# wiktapi.dev dictionary API (port 3000). Start it with HOST=0.0.0.0.
EXPO_PUBLIC_DICT_API_URL=http://<your-device-lan-ip>:3000

# word-bank-server-own (words feed / AI suggestions / analyze, port 4000).
EXPO_PUBLIC_WORDS_FEED_API_URL=http://<your-device-lan-ip>:4000/v1

# Typesense, for typo-tolerant as-you-type word suggestions (port 8108).
# Entirely optional: leave BOTH unset and suggestions keep using Datamuse /
# wiktapi.dev exactly as before. Needs a seeded collection per language — see
# docs/typesense.md and scripts/seed-typesense-words.mjs.
# The key here must be SEARCH-ONLY (it ships inside the app bundle). Keep the
# admin key out of this file — it belongs only in the seed script's --key.
EXPO_PUBLIC_TYPESENSE_HOST=http://<your-device-lan-ip>:8108
EXPO_PUBLIC_TYPESENSE_SEARCH_KEY=<your-search-only-key>
